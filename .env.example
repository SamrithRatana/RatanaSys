GOOGLE_CLIENT_ID=abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=G00gleiuahsdbdbnd
NEXTAUTH_SECRET=safafsasasafasfsafgasfg
